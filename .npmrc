# Supply-chain hardening. See docs/security.md for rationale.

# Block install-time lifecycle scripts (postinstall etc.) — the most common
# npm compromise vector. This repo's dependency tree has no install scripts,
# so nothing legitimate breaks.
ignore-scripts=true

# Never write floating ranges into package.json. Exact pins only.
save-exact=true

# Refuse to install under a Node version outside the engines range.
engine-strict=true

# Fail `npm audit` on high or critical only.
audit-level=high

fund=false
