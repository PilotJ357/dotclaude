{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run sync)",
      "Bash(npm run sync:check)",
      "Bash(npm run validate)",
      "Bash(npm test)",
      "Bash(npm audit:*)",
      "Bash(node --test:*)",
      "Bash(node scripts/sync.mjs:*)",
      "Bash(node scripts/install.mjs --dry-run:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(git branch --show-current)",
      "Bash(git fetch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push -u origin:*)",
      "Bash(gh pr create:*)"
    ],
    "ask": [
      "Bash(git push * --force*)",
      "Bash(git push * -f:*)",
      "Bash(git push * --delete*)",
      "Bash(git push * -d:*)",
      "Bash(git push * +*)"
    ],
    "deny": [
      "Bash(npm install:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  }
}
